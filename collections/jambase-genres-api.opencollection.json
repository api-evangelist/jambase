{
  "opencollection": "1.0.0",
  "info": {
    "name": "JamBase Concert Data Artists Genres API",
    "version": "3.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Genres",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Genres",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.data.jambase.com/v3/genres"
          },
          "docs": "These can be used to filter Artists and Events.\\\n\\\nReturns all Genres in Alphabetical order.\n"
        }
      ]
    }
  ],
  "bundled": true
}