      "item": [
        {
          "name": "Get subscription quota and usage",
          "id": "7c32a0e6-3806-4e23-b5f6-beec36aaec79",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quota",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quota"
              ]
            },
            "description": "Accepts an API key Bearer token or supported OAuth Bearer token. Returns the effective quota and usage for the authenticated shared subscription pool. The effective quota includes applicable plan entitlements, overrides, and bonuses. This endpoint does not meter billing or analytics usage. Response rate-limit headers describe short-window abuse limits, not the subscription quota; overage values are not a provisional estimate of the final charge. For cost projections, use the Usage page."
          },
