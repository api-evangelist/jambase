                        ":festivalSeriesId",
                        "events"
                      ],
                      "query": [
                        {
                          "description": "Include MusicBrainz + Spotify ids per performer.\n- expandExternalIdentifiers=true\n",
                          "key": "expandExternalIdentifiers",
                          "value": "<boolean>"
                        },
                        {
                          "description": "Editions per page (1-100, default 50).",
