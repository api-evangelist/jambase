          "id": "287c2fb4-c1b2-4325-b288-72389799c9c1",
          "name": "Get States / Regions / Provinces",
          "request": {
            "name": "Get States / Regions / Provinces",
            "description": {
              "content": "A States (or Region / Province) is a collection of Cities, such as California (USA) or Quebec (Canada) that can be used to filter Events.\\\n\\\nReturns all States/Regions in Alphabetical order by identifier.\n\\\nNote: Available for United States, Canada, and Australia only.\n",
              "type": "text/plain"
            },
